%% 1
clc;clear;
f=@(x)(x-1)./(x.^2+2);
[x_maxs,maxs]=fminbnd(@(x)-(x-1)./(x.^2+2),-5,5);
maxs=-maxs;
[x_mins,mins]=fminbnd(@(x)(x-1)./(x.^2+2),-5,5);
fplot(f,[-5 5]);
hold on;
plot(x_mins,mins,"Marker","*","MarkerSize",10);
plot(x_maxs,maxs,"Marker","*","MarkerSize",10);

%% 2
clc;clear;
format short;
f=@(x,y)exp(-(x.^2+y.^2));
I=integral2(f,0,pi,0,1);

%% 3
clc;clear;
A=[38 21 0.71 0;
 12 -3.2 2 15;
 32 96 0.5 -2.9;
 5 -8.5 59 2.1];
res1=mean(mean(A));
res2=max(max(A));
res3=A(A<0);
res4=flipud(res3);
syms x
f=poly2sym(res4,x);
eqn1=f==0;
eqn2=(x>-1)&(x<1);
res_zero=eval(solve(eqn1,eqn2));

%% 4
clc;clear;
% 1 ode45
tspan=[0,5];
cond=[0 1];

[t_axis,y1]=ode45(@odefun,tspan,cond);

% 2 simulink

out=sim("q4.slx","stoptime","5");
% 3 syms
syms y(t);
eqn=exp(t)*diff(y,2)-diff(y)+2*y==0;
dy=diff(y);
cond=[y(0)==0;dy(0)==1];
y2=eval(dsolve(eqn,cond));

plot(t_axis,y1(:,1),".b",t_axis,subs(y2,t_axis),":r")
hold on 
plot(out.y3.Time,out.y3.Data,"-.k")
legend()

%% 5 
clc;clear;
x=linspace(-4/pi,4/pi,100);
for i=2:inf
    p=polyfit(x,cos(x),i);
    if(abs(polyval(p,x)-cos(x))<1e-4)
        break
    end
end
plot(x,abs(polyval(p,x)-cos(x)),"LineWidth",1.5)
disp(i)

%%
clc;clear;
x=linspace(-4/pi,4/pi,100);
i=5;
p=polyfit(x,cos(x),i);
if((abs(polyval(p,x)-cos(x))<1e-4)==1)
    disp(1)
end
plot(x,abs(polyval(p,x)-cos(x)))

%% 6
clc;clear;
syms x 
y=(sqrt(sym(pi))-sqrt(acos(x)))./sqrt(x+1);
fplot(y,[-1,0]);
eval(limit(y,x,-1,"right"));

%% 7
clc;clear;
format short;
Wc=2*pi*2.4*10^9;
L=50;C=0.04;
syms Wu  Wl positive real
eqn1=sqrt(Wu*Wl)==Wc;
eqn2=Wu-Wl==0.2*Wc;
eqn3=Wu>Wl;
[res1,res2]=solve([eqn1,eqn2,eqn3],[Wu,Wl]);
sprintf("Wu=%.4fGHz,Wl=%.4fGHz",eval(res1/10^9),eval(res2/10^9))
Ls=eval(L/(res1-res2)*10^9);
Cs=eval((res1-res2)/(Wc^2*L)*10^12);
Lp=eval((res1-res2)/(Wc^2*C)*10^9);
Cp=eval(C/(res1-res2)*10^12);

%% 2
clc;clear;
W0=2*pi*2.4*10^9;
Wu=1.1*W0;
Wl=0.9*W0;
Wc=sqrt(Wu*Wl);
L=50;C=0.04;
Ls=double(L/(Wu-Wl)*10^9);
Cs=double((Wu-Wl)/(Wc^2*L)*10^12);
Lp=double((Wu-Wl)/(Wc^2*C)*10^9);
Cp=double(C/(Wu-Wl)*10^12);



        




 
