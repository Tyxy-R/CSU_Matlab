%% 1
clc;clear;
format short;
x=999+randi(101);
flag=1;
for i=2:1:x/2
    if(mod(x,i)==0)
        flag=0;
        break
    end
end
sprintf("%d %d",x,flag)
%% 2
clc;clear;
p1=[2 4 0 5];
p2=[1 2];
p3=[1 2 3];
p=conv(p1,p2)+[0 0 p3];
syms x
f=@(x)polyval(p,x);
roots(p);
    
%% 3
clc;clear;
x=linspace(-5,5,100);
y=x;
[X,Y]=meshgrid(x,y);
f=(X.^4+Y.^4)./(X.^2+Y.^2+2);
mesh(X,Y,f)

