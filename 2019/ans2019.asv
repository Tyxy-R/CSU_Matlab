E=inv(D);

%% 5
clc;clear;
f=@(x)x.^5+x.^3+1;
res=fzero(f,-1);

%% 6
clc;clear;
f=@(x)-(1+x)./(1+x.^3);
[x0,maxs]=fminbnd(f,0,2);
maxs=-maxs;
% fplot(-1*f,[0,2]);
x=linspace(0,2,1000);
plot(x,-f(x))
hold on;
plot(x0,maxs,"Marker","*","MarkerSize",10)

%% 7
clc;clear;
x=linspace(0,pi,10);
y=@(x)cos(x);
dy=diff(y([x,1.1*pi]));
stem(x,dy)

